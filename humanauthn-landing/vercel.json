{
	"cleanUrls": true,
	"rewrites": [
		{ "source": "/a", "destination": "/index.html" },
		{ "source": "/b", "destination": "/index.html" },
		{ "source": "/es", "destination": "/index.html" },
		{ "source": "/en", "destination": "/index.html" }
	],
	"redirects": [
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "(?<host>(www\\.)?humanauthn\\.(org|io)|(www\\.)?humanauthntech\\.com|www\\.humanauthn\\.com)" }],
			"destination": "https://humanauthn.com/:path*",
			"permanent": true
		}
	]
}
